{
  "name": "mdbindery: Markdown chapters to EPUB and PDF",
  "short_name": "mdbindery",
  "description": "Build EPUB 3 ebooks or paginated PDFs from Markdown chapters and mdBook projects. EPUB is the default; PDF export requires the optional pdf extra.",
